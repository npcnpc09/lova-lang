[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
windows.debug.x86_64 = "res://bin/lova_godot.dll"
windows.release.x86_64 = "res://bin/lova_godot.dll"
linux.debug.x86_64 = "res://bin/liblova_godot.so"
linux.release.x86_64 = "res://bin/liblova_godot.so"
macos.debug = "res://bin/liblova_godot.dylib"
macos.release = "res://bin/liblova_godot.dylib"
