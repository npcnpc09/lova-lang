{"id": "pb01", "name": "partition_number", "prompt": "Given an integer n, return the n-th partition number p(n).", "template": "(p {n})", "tests": [{"inputs": {"n": 12}, "expected": 77}, {"inputs": {"n": 5}, "expected": 7}, {"inputs": {"n": 10}, "expected": 42}], "tags": ["nt", "recall", "single-op"]}
{"id": "pb02", "name": "divisor_count", "prompt": "Given an integer n, return the number of its divisors tau(n).", "template": "(tau {n})", "tests": [{"inputs": {"n": 12}, "expected": 6}, {"inputs": {"n": 100}, "expected": 9}, {"inputs": {"n": 17}, "expected": 2}], "tags": ["nt", "recall", "single-op"]}
{"id": "pb03", "name": "divisor_sum", "prompt": "Given an integer n, return the sum of its divisors sigma(n).", "template": "(sigma {n})", "tests": [{"inputs": {"n": 12}, "expected": 28}, {"inputs": {"n": 6}, "expected": 12}, {"inputs": {"n": 10}, "expected": 18}], "tags": ["nt", "recall", "single-op"]}
{"id": "pb04", "name": "gcd_two", "prompt": "Given two integers a and b, return gcd(a, b).", "template": "(gcd {a} {b})", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 6}, {"inputs": {"a": 100, "b": 75}, "expected": 25}, {"inputs": {"a": 7, "b": 13}, "expected": 1}], "tags": ["nt", "recall", "binary"]}
{"id": "pb05", "name": "mobius", "prompt": "Given an integer n, return the Moebius function value mu(n).", "template": "(mobius {n})", "tests": [{"inputs": {"n": 30}, "expected": -1}, {"inputs": {"n": 12}, "expected": 0}, {"inputs": {"n": 1}, "expected": 1}], "tags": ["nt", "recall", "single-op"]}
{"id": "pb06", "name": "p_of_tau", "prompt": "Compute the partition number of the divisor count of n: p(tau(n)).", "template": "(p (tau {n}))", "tests": [{"inputs": {"n": 12}, "expected": 11}, {"inputs": {"n": 100}, "expected": 30}, {"inputs": {"n": 17}, "expected": 2}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb07", "name": "tau_of_p", "prompt": "Compute the divisor count of the partition number of n: tau(p(n)).", "template": "(tau (p {n}))", "tests": [{"inputs": {"n": 12}, "expected": 4}, {"inputs": {"n": 5}, "expected": 2}, {"inputs": {"n": 10}, "expected": 8}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb08", "name": "sigma_of_tau", "prompt": "Compute the divisor sum of the divisor count of n: sigma(tau(n)).", "template": "(sigma (tau {n}))", "tests": [{"inputs": {"n": 12}, "expected": 12}, {"inputs": {"n": 100}, "expected": 13}, {"inputs": {"n": 17}, "expected": 3}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb09", "name": "sum_p_tau", "prompt": "Compute p(n) + tau(n).", "template": "(merge (p {n}) (tau {n}))", "tests": [{"inputs": {"n": 12}, "expected": 83}, {"inputs": {"n": 5}, "expected": 9}, {"inputs": {"n": 6}, "expected": 15}], "tags": ["nt", "composition", "merge"]}
{"id": "pb10", "name": "gcd_of_sigmas", "prompt": "Given two integers a and b, return gcd(sigma(a), sigma(b)).", "template": "(gcd (sigma {a}) (sigma {b}))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 1}, {"inputs": {"a": 6, "b": 10}, "expected": 6}, {"inputs": {"a": 4, "b": 9}, "expected": 1}], "tags": ["nt", "composition", "binary"]}
{"id": "pb11", "name": "p_p", "prompt": "Compute p(p(n)), the partition-of-partition.", "template": "(p (p {n}))", "tests": [{"inputs": {"n": 5}, "expected": 15}, {"inputs": {"n": 3}, "expected": 3}, {"inputs": {"n": 4}, "expected": 7}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb12", "name": "tau_of_gcd", "prompt": "Compute tau(gcd(a, b)).", "template": "(tau (gcd {a} {b}))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 4}, {"inputs": {"a": 100, "b": 75}, "expected": 3}, {"inputs": {"a": 7, "b": 13}, "expected": 1}], "tags": ["nt", "composition", "binary-depth-2"]}
{"id": "pb13", "name": "sigma_gcd_plus_tau", "prompt": "Compute sigma(gcd(a, b)) + tau(a).", "template": "(merge (sigma (gcd {a} {b})) (tau {a}))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 18}, {"inputs": {"a": 6, "b": 10}, "expected": 7}, {"inputs": {"a": 4, "b": 9}, "expected": 4}], "tags": ["nt", "composition", "depth-3"]}
{"id": "pb14", "name": "mobius_of_p", "prompt": "Compute mu(p(n)), the Moebius of the partition number.", "template": "(mobius (p {n}))", "tests": [{"inputs": {"n": 3}, "expected": -1}, {"inputs": {"n": 5}, "expected": -1}, {"inputs": {"n": 6}, "expected": -1}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb15", "name": "sigma_plus_mobius", "prompt": "Compute sigma(n) + mu(n).", "template": "(merge (sigma {n}) (mobius {n}))", "tests": [{"inputs": {"n": 12}, "expected": 28}, {"inputs": {"n": 30}, "expected": 71}, {"inputs": {"n": 1}, "expected": 2}], "tags": ["nt", "composition", "merge"]}
{"id": "pb16", "name": "let_bound_tau_plus_sigma", "prompt": "Let x = n; return tau(x) + sigma(x).  Must use a let-binding to hold x.", "template": "(let 0 {n} (merge (tau (ref 0)) (sigma (ref 0))))", "tests": [{"inputs": {"n": 10}, "expected": 22}, {"inputs": {"n": 6}, "expected": 16}, {"inputs": {"n": 12}, "expected": 34}], "tags": ["binding", "let-ref", "composition"]}
{"id": "pb17", "name": "p_of_gcd", "prompt": "Compute p(gcd(a, b)).", "template": "(p (gcd {a} {b}))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 11}, {"inputs": {"a": 100, "b": 75}, "expected": 1958}, {"inputs": {"a": 6, "b": 10}, "expected": 2}], "tags": ["nt", "composition", "binary-depth-2"]}
{"id": "pb18", "name": "triple_gcd", "prompt": "Compute gcd(gcd(a, b), c), the three-way gcd.", "template": "(gcd (gcd {a} {b}) {c})", "tests": [{"inputs": {"a": 12, "b": 18, "c": 24}, "expected": 6}, {"inputs": {"a": 100, "b": 75, "c": 50}, "expected": 25}, {"inputs": {"a": 7, "b": 13, "c": 21}, "expected": 1}], "tags": ["nt", "recall", "ternary"]}
{"id": "pb19", "name": "seq_last_is_p", "prompt": "Evaluate p(3), then p(4), then p(5) in sequence; return the last value (p(5)).", "template": "(seq (p 3) (p 4) (p {n}))", "tests": [{"inputs": {"n": 5}, "expected": 7}, {"inputs": {"n": 10}, "expected": 42}, {"inputs": {"n": 12}, "expected": 77}], "tags": ["composition", "seq", "variadic"]}
{"id": "pb20", "name": "surprise_deviation", "prompt": "Return the surprise (deviation) between a prediction `p` and the actual value of p(n).", "template": "(surprise {p} (p {n}))", "tests": [{"inputs": {"p": 77, "n": 12}, "expected": 0}, {"inputs": {"p": 10, "n": 12}, "expected": 67}, {"inputs": {"p": 5, "n": 5}, "expected": 2}], "tags": ["surprise", "binary"]}
{"id": "pb21", "name": "p_tau_sigma", "prompt": "Compute p(tau(sigma(n))) — three-level number-theory composition.", "template": "(p (tau (sigma {n})))", "tests": [{"inputs": {"n": 12}, "expected": 11}, {"inputs": {"n": 6}, "expected": 11}, {"inputs": {"n": 4}, "expected": 2}], "tags": ["nt", "composition", "depth-3"]}
{"id": "pb22", "name": "sigma_gcd_pa_pb", "prompt": "Compute sigma(gcd(p(a), p(b))) for two integers a and b.", "template": "(sigma (gcd (p {a}) (p {b})))", "tests": [{"inputs": {"a": 6, "b": 10}, "expected": 1}, {"inputs": {"a": 4, "b": 9}, "expected": 6}, {"inputs": {"a": 3, "b": 5}, "expected": 1}], "tags": ["nt", "composition", "depth-3", "binary"]}
{"id": "pb23", "name": "triple_tau", "prompt": "Compute tau(tau(tau(n))), three nested divisor-counts.", "template": "(tau (tau (tau {n})))", "tests": [{"inputs": {"n": 24}, "expected": 3}, {"inputs": {"n": 30}, "expected": 3}, {"inputs": {"n": 12}, "expected": 3}], "tags": ["nt", "composition", "depth-3"]}
{"id": "pb24", "name": "mobius_gcd_sigma_tau", "prompt": "Compute mu(gcd(sigma(a), tau(b))).", "template": "(mobius (gcd (sigma {a}) (tau {b})))", "tests": [{"inputs": {"a": 6, "b": 12}, "expected": 1}, {"inputs": {"a": 4, "b": 9}, "expected": 1}, {"inputs": {"a": 10, "b": 15}, "expected": -1}], "tags": ["nt", "composition", "depth-3", "binary"]}
{"id": "pb25", "name": "p_p_tau", "prompt": "Compute p(p(tau(n))).", "template": "(p (p (tau {n})))", "tests": [{"inputs": {"n": 8}, "expected": 7}, {"inputs": {"n": 12}, "expected": 56}, {"inputs": {"n": 6}, "expected": 7}], "tags": ["nt", "composition", "depth-3"]}
{"id": "pb26", "name": "merge_ptau_sigmagcd", "prompt": "Compute p(tau(a)) + sigma(gcd(a, b)) — a four-level merge.", "template": "(merge (p (tau {a})) (sigma (gcd {a} {b})))", "tests": [{"inputs": {"a": 6, "b": 12}, "expected": 17}, {"inputs": {"a": 10, "b": 15}, "expected": 11}, {"inputs": {"a": 4, "b": 9}, "expected": 4}], "tags": ["nt", "composition", "depth-4", "binary"]}
{"id": "pb27", "name": "gcd_sigma_tau_of_p", "prompt": "Compute gcd(sigma(p(n)), tau(p(n))).", "template": "(gcd (sigma (p {n})) (tau (p {n})))", "tests": [{"inputs": {"n": 5}, "expected": 2}, {"inputs": {"n": 3}, "expected": 2}, {"inputs": {"n": 4}, "expected": 2}], "tags": ["nt", "composition", "depth-3"]}
{"id": "pb28", "name": "tau_merge_sigmas", "prompt": "Compute tau(sigma(a) + sigma(b)) — divisor-count of the sum of divisor-sums.", "template": "(tau (merge (sigma {a}) (sigma {b})))", "tests": [{"inputs": {"a": 3, "b": 4}, "expected": 2}, {"inputs": {"a": 6, "b": 8}, "expected": 4}, {"inputs": {"a": 5, "b": 7}, "expected": 4}], "tags": ["nt", "composition", "depth-3", "binary"]}
{"id": "pb29", "name": "sigma_p_gcd", "prompt": "Compute sigma(p(gcd(a, b))).", "template": "(sigma (p (gcd {a} {b})))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 12}, {"inputs": {"a": 6, "b": 10}, "expected": 3}, {"inputs": {"a": 4, "b": 9}, "expected": 1}], "tags": ["nt", "composition", "depth-3", "binary"]}
{"id": "pb30", "name": "sigma_tau_plus_p_mu", "prompt": "Compute sigma(tau(n)) + p(mu(n)).", "template": "(merge (sigma (tau {n})) (p (mobius {n})))", "tests": [{"inputs": {"n": 6}, "expected": 8}, {"inputs": {"n": 10}, "expected": 8}, {"inputs": {"n": 5}, "expected": 3}], "tags": ["nt", "composition", "depth-3"]}
{"id": "pb31", "name": "conserve_p", "prompt": "Compute p(n), verified to equal the expected value k via a conserve contract. Returns p(n); traps if p(n) != k.", "template": "(conserve {k} (p {n}))", "tests": [{"inputs": {"n": 5, "k": 7}, "expected": 7}, {"inputs": {"n": 3, "k": 3}, "expected": 3}, {"inputs": {"n": 10, "k": 42}, "expected": 42}], "tags": ["conserve", "contract"]}
{"id": "pb32", "name": "conserve_tau", "prompt": "Compute tau(n), verified to equal k.", "template": "(conserve {k} (tau {n}))", "tests": [{"inputs": {"n": 12, "k": 6}, "expected": 6}, {"inputs": {"n": 100, "k": 9}, "expected": 9}, {"inputs": {"n": 17, "k": 2}, "expected": 2}], "tags": ["conserve", "contract"]}
{"id": "pb33", "name": "conserve_gcd", "prompt": "Compute gcd(a, b), verified to equal k.", "template": "(conserve {k} (gcd {a} {b}))", "tests": [{"inputs": {"a": 12, "b": 18, "k": 6}, "expected": 6}, {"inputs": {"a": 100, "b": 75, "k": 25}, "expected": 25}, {"inputs": {"a": 7, "b": 13, "k": 1}, "expected": 1}], "tags": ["conserve", "contract", "binary"]}
{"id": "pb34", "name": "conserve_p_plus_tau", "prompt": "Compute p(n) + tau(n), verified to equal k.", "template": "(conserve {k} (merge (p {n}) (tau {n})))", "tests": [{"inputs": {"n": 5, "k": 9}, "expected": 9}, {"inputs": {"n": 10, "k": 46}, "expected": 46}, {"inputs": {"n": 12, "k": 83}, "expected": 83}], "tags": ["conserve", "contract", "composition"]}
{"id": "pb35", "name": "conserve_sigma_gcd", "prompt": "Compute sigma(gcd(a, b)), verified to equal k.", "template": "(conserve {k} (sigma (gcd {a} {b})))", "tests": [{"inputs": {"a": 12, "b": 18, "k": 12}, "expected": 12}, {"inputs": {"a": 6, "b": 10, "k": 3}, "expected": 3}, {"inputs": {"a": 4, "b": 9, "k": 1}, "expected": 1}], "tags": ["conserve", "contract", "binary", "composition"]}
{"id": "pb36", "name": "conserve_mobius", "prompt": "Compute mu(n), verified to equal k (allows negative).", "template": "(conserve {k} (mobius {n}))", "tests": [{"inputs": {"n": 30, "k": -1}, "expected": -1}, {"inputs": {"n": 12, "k": 0}, "expected": 0}, {"inputs": {"n": 1, "k": 1}, "expected": 1}], "tags": ["conserve", "contract", "negative"]}
{"id": "pb37", "name": "conserve_p_of_tau", "prompt": "Compute p(tau(n)), verified to equal k.", "template": "(conserve {k} (p (tau {n})))", "tests": [{"inputs": {"n": 12, "k": 11}, "expected": 11}, {"inputs": {"n": 100, "k": 30}, "expected": 30}, {"inputs": {"n": 17, "k": 2}, "expected": 2}], "tags": ["conserve", "contract", "composition"]}
{"id": "pb38", "name": "conserve_let_tau_sigma", "prompt": "Compute tau(n) + sigma(n) via a let-binding of n, verified to equal k.", "template": "(conserve {k} (let 0 {n} (merge (tau (ref 0)) (sigma (ref 0)))))", "tests": [{"inputs": {"n": 10, "k": 22}, "expected": 22}, {"inputs": {"n": 6, "k": 16}, "expected": 16}, {"inputs": {"n": 12, "k": 34}, "expected": 34}], "tags": ["conserve", "contract", "let-ref"]}
{"id": "pb39", "name": "let_outside_conserve_gcd", "prompt": "Bind a to slot 0, then compute gcd(a, b) verified to equal k inside a conserve scope.", "template": "(let 0 {a} (conserve {k} (gcd (ref 0) {b})))", "tests": [{"inputs": {"a": 12, "b": 18, "k": 6}, "expected": 6}, {"inputs": {"a": 100, "b": 75, "k": 25}, "expected": 25}, {"inputs": {"a": 7, "b": 13, "k": 1}, "expected": 1}], "tags": ["conserve", "let-ref", "binary"]}
{"id": "pb40", "name": "merge_two_conserves", "prompt": "Compute (conserved p(n)) + (conserved tau(n)), given expected values k1 and k2 for each.", "template": "(merge (conserve {k1} (p {n})) (conserve {k2} (tau {n})))", "tests": [{"inputs": {"n": 5, "k1": 7, "k2": 2}, "expected": 9}, {"inputs": {"n": 10, "k1": 42, "k2": 4}, "expected": 46}, {"inputs": {"n": 12, "k1": 77, "k2": 6}, "expected": 83}], "tags": ["conserve", "contract", "merge"]}
{"id": "pb41", "name": "surprise_k_p", "prompt": "Return |k - p(n)|, the surprise magnitude.", "template": "(surprise {k} (p {n}))", "tests": [{"inputs": {"n": 5, "k": 10}, "expected": 3}, {"inputs": {"n": 12, "k": 77}, "expected": 0}, {"inputs": {"n": 3, "k": 3}, "expected": 0}], "tags": ["surprise", "deviation"]}
{"id": "pb42", "name": "surprise_k_tau", "prompt": "Return |k - tau(n)|.", "template": "(surprise {k} (tau {n}))", "tests": [{"inputs": {"n": 12, "k": 10}, "expected": 4}, {"inputs": {"n": 100, "k": 9}, "expected": 0}, {"inputs": {"n": 17, "k": 2}, "expected": 0}], "tags": ["surprise", "deviation"]}
{"id": "pb43", "name": "surprise_p_p", "prompt": "Return |p(n) - p(m)|, the surprise between two partition numbers.", "template": "(surprise (p {n}) (p {m}))", "tests": [{"inputs": {"n": 5, "m": 3}, "expected": 4}, {"inputs": {"n": 12, "m": 5}, "expected": 70}, {"inputs": {"n": 10, "m": 3}, "expected": 39}], "tags": ["surprise", "deviation", "composition"]}
{"id": "pb44", "name": "surprise_perfect_test", "prompt": "Return |sigma(n) - 2n|, zero if n is a perfect number (6, 28, 496, ...).", "template": "(surprise (sigma {n}) (merge {n} {n}))", "tests": [{"inputs": {"n": 6}, "expected": 0}, {"inputs": {"n": 12}, "expected": 4}, {"inputs": {"n": 28}, "expected": 0}], "tags": ["surprise", "deviation", "perfect-number"]}
{"id": "pb45", "name": "is_p_of_n_equal_k", "prompt": "Predicate: return 1 if p(n) equals k else 0 (zero-surprise picks branch 1).", "template": "(if-surprise (surprise {k} (p {n})) 0 1)", "tests": [{"inputs": {"n": 5, "k": 7}, "expected": 1}, {"inputs": {"n": 5, "k": 10}, "expected": 0}, {"inputs": {"n": 12, "k": 77}, "expected": 1}], "tags": ["surprise", "if-surprise", "predicate"]}
{"id": "pb46", "name": "are_coprime", "prompt": "Predicate: return 1 if a and b are coprime (gcd=1) else 0.", "template": "(if-surprise (surprise 1 (gcd {a} {b})) 0 1)", "tests": [{"inputs": {"a": 7, "b": 13}, "expected": 1}, {"inputs": {"a": 12, "b": 18}, "expected": 0}, {"inputs": {"a": 6, "b": 10}, "expected": 0}], "tags": ["surprise", "if-surprise", "predicate", "binary"]}
{"id": "pb47", "name": "is_sigma_of_n_equal_k", "prompt": "Predicate: return 1 if sigma(n) equals k else 0.", "template": "(if-surprise (surprise {k} (sigma {n})) 0 1)", "tests": [{"inputs": {"n": 12, "k": 28}, "expected": 1}, {"inputs": {"n": 6, "k": 12}, "expected": 1}, {"inputs": {"n": 10, "k": 20}, "expected": 0}], "tags": ["surprise", "if-surprise", "predicate"]}
{"id": "pb48", "name": "surprise_tau_sigma_swap", "prompt": "Return |tau(sigma(n)) - sigma(tau(n))| — measures how far tau and sigma commute at n.", "template": "(surprise (tau (sigma {n})) (sigma (tau {n})))", "tests": [{"inputs": {"n": 6}, "expected": 1}, {"inputs": {"n": 12}, "expected": 6}, {"inputs": {"n": 10}, "expected": 1}], "tags": ["surprise", "deviation", "depth-3"]}
{"id": "pb49", "name": "is_squarefree", "prompt": "Predicate: return 1 if n is squarefree (mu != 0), else 0. Non-zero surprise from 0 picks branch 1.", "template": "(if-surprise (surprise 0 (mobius {n})) 1 0)", "tests": [{"inputs": {"n": 30}, "expected": 1}, {"inputs": {"n": 12}, "expected": 0}, {"inputs": {"n": 1}, "expected": 1}], "tags": ["surprise", "if-surprise", "predicate"]}
{"id": "pb50", "name": "surprise_p_diff_via_let", "prompt": "Return |p(a) - p(b)|, binding a and b via nested lets before computing.", "template": "(let 0 {a} (let 1 {b} (surprise (p (ref 0)) (p (ref 1)))))", "tests": [{"inputs": {"a": 5, "b": 3}, "expected": 4}, {"inputs": {"a": 7, "b": 5}, "expected": 8}, {"inputs": {"a": 10, "b": 12}, "expected": 35}], "tags": ["surprise", "let-ref", "deviation"]}
{"id": "pb51", "name": "let_p_plus_tau", "prompt": "Let x = n; compute p(x) + tau(x).", "template": "(let 0 {n} (merge (p (ref 0)) (tau (ref 0))))", "tests": [{"inputs": {"n": 6}, "expected": 15}, {"inputs": {"n": 5}, "expected": 9}, {"inputs": {"n": 10}, "expected": 46}], "tags": ["let-ref", "composition"]}
{"id": "pb52", "name": "let_bound_to_expr_gcd", "prompt": "Let x = gcd(a, b); compute p(x) + tau(x). Binding must hold the computed expression, not a literal.", "template": "(let 0 (gcd {a} {b}) (merge (p (ref 0)) (tau (ref 0))))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 15}, {"inputs": {"a": 6, "b": 10}, "expected": 4}, {"inputs": {"a": 4, "b": 9}, "expected": 2}], "tags": ["let-ref", "composition", "binary"]}
{"id": "pb53", "name": "let_gcd_sigma_tau", "prompt": "Let x = n; return gcd(sigma(x), tau(x)).", "template": "(let 0 {n} (gcd (sigma (ref 0)) (tau (ref 0))))", "tests": [{"inputs": {"n": 6}, "expected": 4}, {"inputs": {"n": 12}, "expected": 2}, {"inputs": {"n": 10}, "expected": 2}], "tags": ["let-ref", "composition"]}
{"id": "pb54", "name": "let_p_plus_tau_of_p", "prompt": "Let x = p(n); return x + tau(x).", "template": "(let 0 (p {n}) (merge (ref 0) (tau (ref 0))))", "tests": [{"inputs": {"n": 5}, "expected": 9}, {"inputs": {"n": 10}, "expected": 50}, {"inputs": {"n": 12}, "expected": 81}], "tags": ["let-ref", "composition"]}
{"id": "pb55", "name": "nested_lets", "prompt": "Let x = n; let y = tau(x); return x + y. Tests nested let-bindings.", "template": "(let 0 {n} (let 1 (tau (ref 0)) (merge (ref 0) (ref 1))))", "tests": [{"inputs": {"n": 6}, "expected": 10}, {"inputs": {"n": 10}, "expected": 14}, {"inputs": {"n": 12}, "expected": 18}], "tags": ["let-ref", "nested", "composition"]}
{"id": "pb56", "name": "nested_lets_binary", "prompt": "Let x = a; let y = b; return gcd(sigma(x), tau(y)).", "template": "(let 0 {a} (let 1 {b} (gcd (sigma (ref 0)) (tau (ref 1)))))", "tests": [{"inputs": {"a": 6, "b": 10}, "expected": 4}, {"inputs": {"a": 12, "b": 18}, "expected": 2}, {"inputs": {"a": 4, "b": 9}, "expected": 1}], "tags": ["let-ref", "nested", "binary"]}
{"id": "pb57", "name": "let_double_sigma", "prompt": "Let x = sigma(n); return x + x. Tests referring to the same let-binding twice.", "template": "(let 0 (sigma {n}) (merge (ref 0) (ref 0)))", "tests": [{"inputs": {"n": 6}, "expected": 24}, {"inputs": {"n": 12}, "expected": 56}, {"inputs": {"n": 10}, "expected": 36}], "tags": ["let-ref", "re-use"]}
{"id": "pb58", "name": "let_gcd_of_sigmas", "prompt": "Let x = sigma(a); let y = sigma(b); return gcd(x, y). Nested lets, each bound to an expression.", "template": "(let 0 (sigma {a}) (let 1 (sigma {b}) (gcd (ref 0) (ref 1))))", "tests": [{"inputs": {"a": 6, "b": 10}, "expected": 6}, {"inputs": {"a": 12, "b": 18}, "expected": 1}, {"inputs": {"a": 4, "b": 9}, "expected": 1}], "tags": ["let-ref", "nested", "binary"]}
{"id": "pb59", "name": "let_p_plus_sigma", "prompt": "Let x = n; return p(x) + sigma(x).", "template": "(let 0 {n} (merge (p (ref 0)) (sigma (ref 0))))", "tests": [{"inputs": {"n": 6}, "expected": 23}, {"inputs": {"n": 5}, "expected": 13}, {"inputs": {"n": 10}, "expected": 60}], "tags": ["let-ref", "composition"]}
{"id": "pb60", "name": "let_p_of_sum", "prompt": "Let x = a + b; return p(x).", "template": "(let 0 (merge {a} {b}) (p (ref 0)))", "tests": [{"inputs": {"a": 2, "b": 3}, "expected": 7}, {"inputs": {"a": 3, "b": 5}, "expected": 22}, {"inputs": {"a": 4, "b": 4}, "expected": 22}], "tags": ["let-ref", "binary"]}
{"id": "pb61", "name": "factorial", "prompt": "Given an integer n >= 0, return n factorial.", "template": "(def fact [n] (if n (mul n (fact (sub n 1))) 1))(fact {n})", "tests": [{"inputs": {"n": 0}, "expected": 1}, {"inputs": {"n": 5}, "expected": 120}, {"inputs": {"n": 10}, "expected": 3628800}], "tags": ["algorithmic", "recursion", "primitive-recursion"]}
{"id": "pb62", "name": "fibonacci", "prompt": "Given an integer n >= 0, return the n-th Fibonacci number, with F(0) = 0 and F(1) = 1.", "template": "(def fib [n] (if (lt n 2) n (merge (fib (sub n 1)) (fib (sub n 2)))))(fib {n})", "tests": [{"inputs": {"n": 0}, "expected": 0}, {"inputs": {"n": 7}, "expected": 13}, {"inputs": {"n": 15}, "expected": 610}], "tags": ["algorithmic", "recursion", "tree-recursion"]}
{"id": "pb63", "name": "is_prime", "prompt": "Given an integer n, return 1 if n is prime and 0 otherwise.", "template": "(def check [d n] (if (gt (mul d d) n) 1 (if (mod n d) (check (inc d) n) 0)))(def prime? [n] (if (lt n 2) 0 (check 2 n)))(prime? {n})", "tests": [{"inputs": {"n": 1}, "expected": 0}, {"inputs": {"n": 97}, "expected": 1}, {"inputs": {"n": 561}, "expected": 0}], "tags": ["algorithmic", "loop", "early-exit"]}
{"id": "pb64", "name": "collatz_steps", "prompt": "Given an integer n >= 1, return how many Collatz steps (halve if even, else 3n+1) it takes to reach 1.", "template": "(def next [n] (if (mod n 2) (merge (mul 3 n) 1) (div n 2)))(def steps [n acc] (if (eq n 1) acc (steps (next n) (inc acc))))(steps {n} 0)", "tests": [{"inputs": {"n": 1}, "expected": 0}, {"inputs": {"n": 6}, "expected": 8}, {"inputs": {"n": 27}, "expected": 111}], "tags": ["algorithmic", "loop", "accumulator"]}
{"id": "pb65", "name": "sum_to", "prompt": "Given an integer n >= 0, return the sum 1 + 2 + ... + n.", "template": "(sum (range 1 (inc {n})))", "tests": [{"inputs": {"n": 0}, "expected": 0}, {"inputs": {"n": 10}, "expected": 55}, {"inputs": {"n": 100}, "expected": 5050}], "tags": ["algorithmic", "list", "library"]}
{"id": "pb66", "name": "power", "prompt": "Given integers b and e >= 0, return b raised to the power e.", "template": "(def power [b e] (if e (mul b (power b (sub e 1))) 1))(power {b} {e})", "tests": [{"inputs": {"b": 2, "e": 10}, "expected": 1024}, {"inputs": {"b": 3, "e": 0}, "expected": 1}, {"inputs": {"b": 5, "e": 3}, "expected": 125}], "tags": ["algorithmic", "recursion", "binary"]}
{"id": "pb67", "name": "gcd_euclid", "prompt": "Given integers a and b, return their greatest common divisor by Euclid's algorithm, without the gcd operator.", "template": "(def euclid [a b] (if b (euclid b (mod a b)) a))(euclid {a} {b})", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 6}, {"inputs": {"a": 270, "b": 192}, "expected": 6}, {"inputs": {"a": 0, "b": 5}, "expected": 5}], "tags": ["algorithmic", "recursion", "binary"]}
{"id": "pb68", "name": "count_divisors_loop", "prompt": "Given an integer n >= 1, return the number of its divisors, counted by trying every candidate from 1 to n.", "template": "(len (filter (lambda d (not (mod {n} d))) (range 1 (inc {n}))))", "tests": [{"inputs": {"n": 1}, "expected": 1}, {"inputs": {"n": 12}, "expected": 6}, {"inputs": {"n": 28}, "expected": 6}], "tags": ["algorithmic", "list", "filter"]}
{"id": "pb69", "name": "digit_sum", "prompt": "Given an integer n >= 0, return the sum of its decimal digits.", "template": "(sum (digits {n}))", "tests": [{"inputs": {"n": 0}, "expected": 0}, {"inputs": {"n": 1234}, "expected": 10}, {"inputs": {"n": 99999}, "expected": 45}], "tags": ["algorithmic", "list", "library"]}
{"id": "pb70", "name": "reverse_digits", "prompt": "Given an integer n >= 0, return the integer whose decimal digits are those of n in reverse order.", "template": "(def rev [n acc] (if n (rev (div n 10) (merge (mul acc 10) (mod n 10))) acc))(rev {n} 0)", "tests": [{"inputs": {"n": 1234}, "expected": 4321}, {"inputs": {"n": 1200}, "expected": 21}, {"inputs": {"n": 7}, "expected": 7}], "tags": ["algorithmic", "loop", "accumulator"]}
{"id": "pb71", "name": "sum_of_squares", "prompt": "Given an integer n >= 1, return the sum of the squares of 1 to n.", "template": "(sum (map (lambda k (mul k k)) (range 1 (inc {n}))))", "tests": [{"inputs": {"n": 1}, "expected": 1}, {"inputs": {"n": 3}, "expected": 14}, {"inputs": {"n": 10}, "expected": 385}], "tags": ["algorithmic", "list", "map"]}
{"id": "pb72", "name": "primes_below", "prompt": "Given an integer n, return how many primes are smaller than n.", "template": "(def check [d n] (if (gt (mul d d) n) 1 (if (mod n d) (check (inc d) n) 0)))(def prime? [n] (if (lt n 2) 0 (check 2 n)))(len (filter prime? (range 2 {n})))", "tests": [{"inputs": {"n": 10}, "expected": 4}, {"inputs": {"n": 30}, "expected": 10}, {"inputs": {"n": 100}, "expected": 25}], "tags": ["algorithmic", "list", "filter", "composition"]}
{"id": "pb73", "name": "largest_digit", "prompt": "Given an integer n >= 0, return its largest decimal digit.", "template": "(fold (lambda a (lambda b (max a b))) 0 (digits {n}))", "tests": [{"inputs": {"n": 1234}, "expected": 4}, {"inputs": {"n": 907}, "expected": 9}, {"inputs": {"n": 5}, "expected": 5}], "tags": ["algorithmic", "list", "fold"]}
{"id": "pb74", "name": "binary_ones", "prompt": "Given an integer n >= 0, return the number of 1 bits in its binary representation.", "template": "(def ones [n] (if n (merge (mod n 2) (ones (div n 2))) 0))(ones {n})", "tests": [{"inputs": {"n": 0}, "expected": 0}, {"inputs": {"n": 255}, "expected": 8}, {"inputs": {"n": 1000}, "expected": 6}], "tags": ["algorithmic", "recursion"]}
{"id": "pb75", "name": "palindrome_number", "prompt": "Given an integer n >= 0, return 1 if its decimal digits read the same backwards and 0 otherwise.", "template": "(same (digits {n}) (reverse (digits {n})))", "tests": [{"inputs": {"n": 121}, "expected": 1}, {"inputs": {"n": 123}, "expected": 0}, {"inputs": {"n": 7}, "expected": 1}], "tags": ["algorithmic", "list", "library"]}
{"id": "pb76", "name": "floor_log2", "prompt": "Given an integer n >= 1, return how many times n can be halved (rounding down) before it is smaller than 2.", "template": "(def lg [n] (if (lt n 2) 0 (inc (lg (div n 2)))))(lg {n})", "tests": [{"inputs": {"n": 1}, "expected": 0}, {"inputs": {"n": 8}, "expected": 3}, {"inputs": {"n": 1000}, "expected": 9}], "tags": ["algorithmic", "recursion"]}
{"id": "pb77", "name": "is_perfect_by_loop", "prompt": "Given an integer n >= 1, return 1 if n equals the sum of its proper divisors (those smaller than n) and 0 otherwise.", "template": "(eq {n} (sum (filter (lambda d (not (mod {n} d))) (range 1 {n}))))", "tests": [{"inputs": {"n": 6}, "expected": 1}, {"inputs": {"n": 28}, "expected": 1}, {"inputs": {"n": 12}, "expected": 0}], "tags": ["algorithmic", "list", "filter"]}
{"id": "pb78", "name": "count_multiples", "prompt": "Given an integer n >= 1, return how many integers from 1 to n are divisible by 3 or by 5.", "template": "(len (filter (lambda k (or (not (mod k 3)) (not (mod k 5)))) (range 1 (inc {n}))))", "tests": [{"inputs": {"n": 10}, "expected": 5}, {"inputs": {"n": 15}, "expected": 7}, {"inputs": {"n": 100}, "expected": 47}], "tags": ["algorithmic", "list", "filter"]}
{"id": "pb79", "name": "decimal_length", "prompt": "Given an integer n >= 0, return the number of characters in its decimal representation.", "template": "(len (text-of {n}))", "tests": [{"inputs": {"n": 0}, "expected": 1}, {"inputs": {"n": 12345}, "expected": 5}, {"inputs": {"n": 1000000}, "expected": 7}], "tags": ["algorithmic", "text", "library"]}
{"id": "pb80", "name": "sorted_digits", "prompt": "Given an integer n >= 0, return the integer formed by its decimal digits sorted in ascending order (a leading zero disappears).", "template": "(fold (lambda a (lambda d (merge (mul a 10) d))) 0 (sort (digits {n})))", "tests": [{"inputs": {"n": 3142}, "expected": 1234}, {"inputs": {"n": 5}, "expected": 5}, {"inputs": {"n": 909}, "expected": 99}], "tags": ["algorithmic", "list", "sort", "fold"]}
