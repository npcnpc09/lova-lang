{"id": "pb01", "name": "partition_number", "prompt": "Given an integer n, return the n-th partition number p(n).", "template": "(p {n})", "tests": [{"inputs": {"n": 12}, "expected": 77}, {"inputs": {"n": 5}, "expected": 7}, {"inputs": {"n": 10}, "expected": 42}], "tags": ["nt", "recall", "single-op"]}
{"id": "pb02", "name": "divisor_count", "prompt": "Given an integer n, return the number of its divisors tau(n).", "template": "(tau {n})", "tests": [{"inputs": {"n": 12}, "expected": 6}, {"inputs": {"n": 100}, "expected": 9}, {"inputs": {"n": 17}, "expected": 2}], "tags": ["nt", "recall", "single-op"]}
{"id": "pb03", "name": "divisor_sum", "prompt": "Given an integer n, return the sum of its divisors sigma(n).", "template": "(sigma {n})", "tests": [{"inputs": {"n": 12}, "expected": 28}, {"inputs": {"n": 6}, "expected": 12}, {"inputs": {"n": 10}, "expected": 18}], "tags": ["nt", "recall", "single-op"]}
{"id": "pb04", "name": "gcd_two", "prompt": "Given two integers a and b, return gcd(a, b).", "template": "(gcd {a} {b})", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 6}, {"inputs": {"a": 100, "b": 75}, "expected": 25}, {"inputs": {"a": 7, "b": 13}, "expected": 1}], "tags": ["nt", "recall", "binary"]}
{"id": "pb05", "name": "mobius", "prompt": "Given an integer n, return the Moebius function value mu(n).", "template": "(mobius {n})", "tests": [{"inputs": {"n": 30}, "expected": -1}, {"inputs": {"n": 12}, "expected": 0}, {"inputs": {"n": 1}, "expected": 1}], "tags": ["nt", "recall", "single-op"]}
{"id": "pb06", "name": "p_of_tau", "prompt": "Compute the partition number of the divisor count of n: p(tau(n)).", "template": "(p (tau {n}))", "tests": [{"inputs": {"n": 12}, "expected": 11}, {"inputs": {"n": 100}, "expected": 30}, {"inputs": {"n": 17}, "expected": 2}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb07", "name": "tau_of_p", "prompt": "Compute the divisor count of the partition number of n: tau(p(n)).", "template": "(tau (p {n}))", "tests": [{"inputs": {"n": 12}, "expected": 4}, {"inputs": {"n": 5}, "expected": 2}, {"inputs": {"n": 10}, "expected": 8}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb08", "name": "sigma_of_tau", "prompt": "Compute the divisor sum of the divisor count of n: sigma(tau(n)).", "template": "(sigma (tau {n}))", "tests": [{"inputs": {"n": 12}, "expected": 12}, {"inputs": {"n": 100}, "expected": 13}, {"inputs": {"n": 17}, "expected": 3}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb09", "name": "sum_p_tau", "prompt": "Compute p(n) + tau(n).", "template": "(merge (p {n}) (tau {n}))", "tests": [{"inputs": {"n": 12}, "expected": 83}, {"inputs": {"n": 5}, "expected": 9}, {"inputs": {"n": 6}, "expected": 15}], "tags": ["nt", "composition", "merge"]}
{"id": "pb10", "name": "gcd_of_sigmas", "prompt": "Given two integers a and b, return gcd(sigma(a), sigma(b)).", "template": "(gcd (sigma {a}) (sigma {b}))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 1}, {"inputs": {"a": 6, "b": 10}, "expected": 6}, {"inputs": {"a": 4, "b": 9}, "expected": 1}], "tags": ["nt", "composition", "binary"]}
{"id": "pb11", "name": "p_p", "prompt": "Compute p(p(n)), the partition-of-partition.", "template": "(p (p {n}))", "tests": [{"inputs": {"n": 5}, "expected": 15}, {"inputs": {"n": 3}, "expected": 3}, {"inputs": {"n": 4}, "expected": 7}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb12", "name": "tau_of_gcd", "prompt": "Compute tau(gcd(a, b)).", "template": "(tau (gcd {a} {b}))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 4}, {"inputs": {"a": 100, "b": 75}, "expected": 3}, {"inputs": {"a": 7, "b": 13}, "expected": 1}], "tags": ["nt", "composition", "binary-depth-2"]}
{"id": "pb13", "name": "sigma_gcd_plus_tau", "prompt": "Compute sigma(gcd(a, b)) + tau(a).", "template": "(merge (sigma (gcd {a} {b})) (tau {a}))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 18}, {"inputs": {"a": 6, "b": 10}, "expected": 7}, {"inputs": {"a": 4, "b": 9}, "expected": 4}], "tags": ["nt", "composition", "depth-3"]}
{"id": "pb14", "name": "mobius_of_p", "prompt": "Compute mu(p(n)), the Moebius of the partition number.", "template": "(mobius (p {n}))", "tests": [{"inputs": {"n": 3}, "expected": -1}, {"inputs": {"n": 5}, "expected": -1}, {"inputs": {"n": 6}, "expected": -1}], "tags": ["nt", "composition", "depth-2"]}
{"id": "pb15", "name": "sigma_plus_mobius", "prompt": "Compute sigma(n) + mu(n).", "template": "(merge (sigma {n}) (mobius {n}))", "tests": [{"inputs": {"n": 12}, "expected": 28}, {"inputs": {"n": 30}, "expected": 71}, {"inputs": {"n": 1}, "expected": 2}], "tags": ["nt", "composition", "merge"]}
{"id": "pb16", "name": "let_bound_tau_plus_sigma", "prompt": "Let x = n; return tau(x) + sigma(x).  Must use a let-binding to hold x.", "template": "(let 0 {n} (merge (tau (ref 0)) (sigma (ref 0))))", "tests": [{"inputs": {"n": 10}, "expected": 22}, {"inputs": {"n": 6}, "expected": 16}, {"inputs": {"n": 12}, "expected": 34}], "tags": ["binding", "let-ref", "composition"]}
{"id": "pb17", "name": "p_of_gcd", "prompt": "Compute p(gcd(a, b)).", "template": "(p (gcd {a} {b}))", "tests": [{"inputs": {"a": 12, "b": 18}, "expected": 11}, {"inputs": {"a": 100, "b": 75}, "expected": 1958}, {"inputs": {"a": 6, "b": 10}, "expected": 2}], "tags": ["nt", "composition", "binary-depth-2"]}
{"id": "pb18", "name": "triple_gcd", "prompt": "Compute gcd(gcd(a, b), c), the three-way gcd.", "template": "(gcd (gcd {a} {b}) {c})", "tests": [{"inputs": {"a": 12, "b": 18, "c": 24}, "expected": 6}, {"inputs": {"a": 100, "b": 75, "c": 50}, "expected": 25}, {"inputs": {"a": 7, "b": 13, "c": 21}, "expected": 1}], "tags": ["nt", "recall", "ternary"]}
{"id": "pb19", "name": "seq_last_is_p", "prompt": "Evaluate p(3), then p(4), then p(5) in sequence; return the last value (p(5)).", "template": "(seq (p 3) (p 4) (p {n}))", "tests": [{"inputs": {"n": 5}, "expected": 7}, {"inputs": {"n": 10}, "expected": 42}, {"inputs": {"n": 12}, "expected": 77}], "tags": ["composition", "seq", "variadic"]}
{"id": "pb20", "name": "surprise_deviation", "prompt": "Return the surprise (deviation) between a prediction `p` and the actual value of p(n).", "template": "(surprise {p} (p {n}))", "tests": [{"inputs": {"p": 77, "n": 12}, "expected": 0}, {"inputs": {"p": 10, "n": 12}, "expected": 67}, {"inputs": {"p": 5, "n": 5}, "expected": 2}], "tags": ["surprise", "binary"]}
