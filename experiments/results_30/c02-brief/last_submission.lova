(def lines3 [] (list (list 0 1 2) (list 3 4 5) (list 6 7 8)
                     (list 0 3 6) (list 1 4 7) (list 2 5 8)
                     (list 0 4 8) (list 2 4 6)))
(def line-win [b l]
  (let a (nth b (nth l 0))
    (if (and (ne a 46) (and (eq a (nth b (nth l 1))) (eq a (nth b (nth l 2))))) a 0)))
(def winner-of [b ls]
  (if (nil? ls) 0 (let w (line-win b (head ls)) (if w w (winner-of b (tail ls))))))
(def winner [b] (winner-of b lines3))
(def full [b] (not (contains b 46)))
(def other [p] (if (eq p 88) 79 88))
(def set-at [xs i v]
  (if (eq i 0) (cons v (tail xs)) (cons (head xs) (set-at (tail xs) (sub i 1) v))))
(def move-order [] (list 4 0 2 6 8 1 3 5 7))
(def nmax [b p alpha beta]
  (if (winner b) (neg 1)
    (if (full b) 0 (nloop b p move-order alpha beta (neg 2)))))
(def nloop [b p order alpha beta best]
  (if (nil? order) best
    (let i (head order)
      (if (ne (nth b i) 46) (nloop b p (tail order) alpha beta best)
        (let v (neg (nmax (set-at b i p) (other p) (neg beta) (neg alpha)))
          (let best2 (max best v)
            (let a2 (max alpha v)
              (if (ge a2 beta) best2 (nloop b p (tail order) a2 beta best2)))))))))
(def root-order [] (list 0 1 2 3 4 5 6 7 8))
(def pick [b p order alpha besti bestv]
  (if (nil? order) besti
    (let i (head order)
      (if (ne (nth b i) 46) (pick b p (tail order) alpha besti bestv)
        (let v (neg (nmax (set-at b i p) (other p) (neg 2) (neg alpha)))
          (let besti2 (if (gt v bestv) i besti)
            (let bestv2 (max bestv v)
              (let a2 (max alpha v)
                (pick b p (tail order) a2 besti2 bestv2)))))))))
(let b (text-chars {board}) (pick b (head {side}) root-order (neg 2) 0 (neg 2)))
