(def wins [] (list (list 0 1 2) (list 3 4 5) (list 6 7 8)
                   (list 0 3 6) (list 1 4 7) (list 2 5 8)
                   (list 0 4 8) (list 2 4 6)))
(def bget [b i] (map-get b i 46))
(def line-win [b p ln]
  (and (eq (bget b (nth ln 0)) p)
       (and (eq (bget b (nth ln 1)) p) (eq (bget b (nth ln 2)) p))))
(def has-win [b p] (any (lambda ln (line-win b p ln)) wins))
(def opp [p] (if (eq p 88) 79 88))
(def put-at [b i v] (map-put b i v))
(def code [c] (if (eq c 88) 1 (if (eq c 79) 2 0)))
(def pow3 [] (list 6561 2187 729 243 81 27 9 3 1))
(def idxs [] (range 0 9))
(def bkey [b] (fold (lambda a (lambda i (merge (mul a 3) (code (bget b i))))) 0 idxs))
(def count-empty [b] (fold (lambda a (lambda i (if (eq (bget b i) 46) (inc a) a))) 0 idxs))
(def build-board [chars] (fold (lambda a (lambda pr (map-put a (head pr) (head (tail pr))))) (nil) (zip idxs chars)))
(def best [b p k bk mm]
  (let kk (merge (mul bk 2) (if (eq p 88) 1 0))
    (let hit (map-get mm kk 9)
      (if (ne hit 9) (rec s hit m mm)
        (let res (best2 b p k bk mm)
          (rec s (get res s) m (map-put (get res m) kk (get res s))))))))
(def best2 [b p k bk mm]
  (if (has-win b (opp p)) (rec s (neg 1) m mm)
    (if (eq k 0) (rec s 0 m mm)
      (bestloop b p k bk 0 (neg 2) mm))))
(def bestloop [b p k bk i acc mm]
  (if (eq i 9) (rec s acc m mm)
    (if (ne (bget b i) 46) (bestloop b p k bk (inc i) acc mm)
      (let bk2 (merge bk (mul (code p) (nth pow3 i)))
        (let r (best (put-at b i p) (opp p) (sub k 1) bk2 mm)
          (bestloop b p k bk (inc i) (max acc (neg (get r s))) (get r m)))))))
(def pick [b p k bk i bi bs mm]
  (if (eq i 9) bi
    (if (ne (bget b i) 46) (pick b p k bk (inc i) bi bs mm)
      (let bk2 (merge bk (mul (code p) (nth pow3 i)))
        (let r (best (put-at b i p) (opp p) (sub k 1) bk2 mm)
          (let sc (neg (get r s))
            (if (gt sc bs) (pick b p k bk (inc i) i sc (get r m))
                           (pick b p k bk (inc i) bi bs (get r m)))))))))
(let chars (text-chars {board})
  (let b (build-board chars)
    (let k (count-empty b)
      (let bk (bkey b)
        (pick b (head {side}) k bk 0 0 (neg 2) (map-of (nil)))))))
