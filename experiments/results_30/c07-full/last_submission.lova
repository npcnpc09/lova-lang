(def idc [c] c)
(def order [] (list 4 0 2 6 8 1 3 5 7))
(def setat [xs i v] (if (eq i 0) (cons v (tail xs)) (cons (head xs) (setat (tail xs) (sub i 1) v))))
(def line3 [b a c d who] (and (eq (nth b a) who) (and (eq (nth b c) who) (eq (nth b d) who))))
(def wonAt [b who i]
  (cond
    (eq i 0) (or (line3 b 0 1 2 who) (or (line3 b 0 3 6 who) (line3 b 0 4 8 who)))
    (eq i 1) (or (line3 b 0 1 2 who) (line3 b 1 4 7 who))
    (eq i 2) (or (line3 b 0 1 2 who) (or (line3 b 2 5 8 who) (line3 b 2 4 6 who)))
    (eq i 3) (or (line3 b 3 4 5 who) (line3 b 0 3 6 who))
    (eq i 4) (or (line3 b 3 4 5 who) (or (line3 b 1 4 7 who) (or (line3 b 0 4 8 who) (line3 b 2 4 6 who))))
    (eq i 5) (or (line3 b 3 4 5 who) (line3 b 2 5 8 who))
    (eq i 6) (or (line3 b 6 7 8 who) (or (line3 b 0 3 6 who) (line3 b 2 4 6 who)))
    (eq i 7) (or (line3 b 6 7 8 who) (line3 b 1 4 7 who))
    (or (line3 b 6 7 8 who) (or (line3 b 2 5 8 who) (line3 b 0 4 8 who)))))
(def nm [b who alpha beta idxs e]
  (if (nil? idxs) alpha
    (let i (head idxs)
      (if (ne (nth b i) 46) (nm b who alpha beta (tail idxs) e)
        (let nb (setat b i who)
          (let v (if (wonAt nb who i) 1
                   (if (eq e 1) 0
                     (neg (nm nb (if (eq who 88) 79 88) (neg beta) (neg alpha) order (sub e 1)))))
            (let a2 (max alpha v)
              (if (ge a2 beta) a2 (nm b who a2 beta (tail idxs) e)))))))))
(def pick [b who i rest e bi bv]
  (if (nil? rest) bi
    (if (eq bv 1) bi
      (if (ne (head rest) 46) (pick b who (merge i 1) (tail rest) e bi bv)
        (let nb (setat b i who)
          (let v (if (wonAt nb who i) 1
                   (if (eq e 1) 0
                     (neg (nm nb (if (eq who 88) 79 88) (neg 2) (neg bv) order (sub e 1)))))
            (if (gt v bv)
              (pick b who (merge i 1) (tail rest) e i v)
              (pick b who (merge i 1) (tail rest) e bi bv))))))))
(let b (map idc {board})
  (let s (head {side})
    (pick b s 0 b (len (filter (lambda c (eq c 46)) b)) (neg 1) (neg 2))))
