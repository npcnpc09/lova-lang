(def idc [c] c)
(def setat [xs i v] (if (eq i 0) (cons v (tail xs)) (cons (head xs) (setat (tail xs) (sub i 1) v))))
(def check-line [b who ln] (and (eq (nth b (nth ln 0)) who) (and (eq (nth b (nth ln 1)) who) (eq (nth b (nth ln 2)) who))))
(def lines-for [i]
  (cond (eq i 0) (list (list 0 1 2) (list 0 3 6) (list 0 4 8))
        (eq i 1) (list (list 0 1 2) (list 1 4 7))
        (eq i 2) (list (list 0 1 2) (list 2 5 8) (list 2 4 6))
        (eq i 3) (list (list 3 4 5) (list 0 3 6))
        (eq i 4) (list (list 3 4 5) (list 1 4 7) (list 0 4 8) (list 2 4 6))
        (eq i 5) (list (list 3 4 5) (list 2 5 8))
        (eq i 6) (list (list 6 7 8) (list 0 3 6) (list 2 4 6))
        (eq i 7) (list (list 6 7 8) (list 1 4 7))
        (list (list 6 7 8) (list 2 5 8) (list 0 4 8))))
(def won-at [b who i] (any (lambda ln (check-line b who ln)) (lines-for i)))
(def order [] (list 4 0 2 6 8 1 3 5 7))
(def nm [b who alpha beta idxs e]
  (if (nil? idxs) alpha
    (let i (head idxs)
      (if (ne (nth b i) 46) (nm b who alpha beta (tail idxs) e)
        (let nb (setat b i who)
          (let v (if (won-at nb who i) 1
                   (if (eq e 1) 0
                     (neg (nm nb (if (eq who 88) 79 88) (neg beta) (neg alpha) order (sub e 1)))))
            (let a2 (max alpha v)
              (if (ge a2 beta) a2 (nm b who a2 beta (tail idxs) e)))))))))
(def pick [b who i rest e bi bv]
  (if (nil? rest) bi
    (if (eq bv 1) bi
      (if (ne (head rest) 46) (pick b who (merge i 1) (tail rest) e bi bv)
        (let nb (setat b i who)
          (let v (if (won-at nb who i) 1
                   (if (eq e 1) 0
                     (neg (nm nb (if (eq who 88) 79 88) (neg 2) (neg bv) order (sub e 1)))))
            (if (gt v bv)
              (pick b who (merge i 1) (tail rest) e i v)
              (pick b who (merge i 1) (tail rest) e bi bv))))))))
(let b (map idc {board})
  (let s (head {side})
    (pick b s 0 b (len (filter (lambda c (eq c 46)) b)) (neg 1) (neg 2))))
