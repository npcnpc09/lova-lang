(def idc [c] c)
(def ordL [] (list 4 0 2 6 8 1 3 5 7))
(def t3 [x y z v] (and (eq x v) (and (eq y v) (eq z v))))
(def setat [xs i v] (if (eq i 0) (cons v (tail xs)) (cons (head xs) (setat (tail xs) (sub i 1) v))))
(def winAt [b i v]
  (let q0 (head b) (let r1 (tail b)
  (let q1 (head r1) (let r2 (tail r1)
  (let q2 (head r2) (let r3 (tail r2)
  (let q3 (head r3) (let r4 (tail r3)
  (let q4 (head r4) (let r5 (tail r4)
  (let q5 (head r5) (let r6 (tail r5)
  (let q6 (head r6) (let r7 (tail r6)
  (let q7 (head r7) (let r8 (tail r7)
  (let q8 (head r8)
    (cond
      (eq i 0) (or (t3 q0 q1 q2 v) (or (t3 q0 q3 q6 v) (t3 q0 q4 q8 v)))
      (eq i 1) (or (t3 q0 q1 q2 v) (t3 q1 q4 q7 v))
      (eq i 2) (or (t3 q0 q1 q2 v) (or (t3 q2 q5 q8 v) (t3 q2 q4 q6 v)))
      (eq i 3) (or (t3 q3 q4 q5 v) (t3 q0 q3 q6 v))
      (eq i 4) (or (t3 q3 q4 q5 v) (or (t3 q1 q4 q7 v) (or (t3 q0 q4 q8 v) (t3 q2 q4 q6 v))))
      (eq i 5) (or (t3 q3 q4 q5 v) (t3 q2 q5 q8 v))
      (eq i 6) (or (t3 q6 q7 q8 v) (or (t3 q0 q3 q6 v) (t3 q2 q4 q6 v)))
      (eq i 7) (or (t3 q6 q7 q8 v) (t3 q1 q4 q7 v))
      (or (t3 q6 q7 q8 v) (or (t3 q2 q5 q8 v) (t3 q0 q4 q8 v)))
  )))))))))))))))))))
(def other [w] (if (eq w 88) 79 88))
(def nm [b who alpha beta rest e]
  (if (nil? rest) alpha
    (let i (head rest)
      (if (ne (nth b i) 46) (nm b who alpha beta (tail rest) e)
        (let nb (setat b i who)
          (let v (if (winAt nb i who) 1 (if (eq e 1) 0 (neg (nm nb (other who) (neg beta) (neg alpha) ordL (sub e 1)))))
            (let a2 (max alpha v)
              (if (ge a2 beta) a2 (nm b who a2 beta (tail rest) e)))))))))
(def pick [b who i rest e bi bv]
  (if (nil? rest) bi
    (if (eq bv 1) bi
      (if (ne (head rest) 46) (pick b who (inc i) (tail rest) e bi bv)
        (let nb (setat b i who)
          (let v (if (winAt nb i who) 1 (if (eq e 1) 0 (neg (nm nb (other who) (neg 2) 2 ordL (sub e 1)))))
            (if (gt v bv) (pick b who (inc i) (tail rest) e i v) (pick b who (inc i) (tail rest) e bi bv))))))))
(let b (map idc {board})
  (let s (head {side})
    (pick b s 0 b (len (filter (lambda c (eq c 46)) b)) (neg 1) (neg 2))))
