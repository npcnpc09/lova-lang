(def wins [] (list (list 0 1 2) (list 3 4 5) (list 6 7 8)
                   (list 0 3 6) (list 1 4 7) (list 2 5 8)
                   (list 0 4 8) (list 2 4 6)))
(def winline [b l]
  (let a (nth b (nth l 0))
    (if (eq a 46) 0
      (if (and (eq a (nth b (nth l 1))) (eq a (nth b (nth l 2)))) a 0))))
(def winner [b] (fold (lambda acc (lambda l (if acc acc (winline b l)))) 0 wins))
(def full [b] (not (contains b 46)))
(def empties [b] (filter (lambda i (eq (nth b i) 46)) (range 0 9)))
(def setat [b i c] (append (take i b) (cons c (drop (inc i) b))))
(def other [c] (if (eq c 88) 79 88))
(def digit [c] (if (eq c 46) 0 (if (eq c 88) 1 2)))
(def encode [b] (fold (lambda v (lambda c (merge (mul v 3) (digit c)))) 0 b))
(def places [] (list 6561 2187 729 243 81 27 9 3 1))
(def place [i] (nth places i))
(def key [code cur] (merge (mul code 2) (if (eq cur 88) 0 1)))
(def loopmoves [b code cur me ms memo best maximizing]
  (if (nil? ms) (rec val best memo memo)
    (let i (head ms)
      (let r (ab (setat b i cur) (merge code (mul (digit cur) (place i))) (other cur) me memo)
        (loopmoves b code cur me (tail ms)
          (get r memo)
          (if maximizing (max best (get r val)) (min best (get r val)))
          maximizing)))))
(def ab [b code cur me memo]
  (let k (key code cur)
    (let cached (map-get memo k -2)
      (if (ne cached -2) (rec val cached memo memo)
        (let wn (winner b)
          (if wn
              (let s (if (eq wn me) 1 (neg 1)) (rec val s memo (map-put memo k s)))
            (if (full b) (rec val 0 memo (map-put memo k 0))
              (let r (loopmoves b code cur me (empties b) memo (if (eq cur me) (neg 2) 2) (eq cur me))
                (rec val (get r val) memo (map-put (get r memo) k (get r val)))))))))))
(def pick [b code me ms bi bs memo]
  (if (nil? ms) bi
    (let i (head ms)
      (let r (ab (setat b i me) (merge code (mul (digit me) (place i))) (other me) me memo)
        (if (gt (get r val) bs)
          (pick b code me (tail ms) i (get r val) (get r memo))
          (pick b code me (tail ms) bi bs (get r memo)))))))
(let b (text-chars {board})
  (let me (head (text-chars {side}))
    (pick b (encode b) me (empties b) (neg 1) (neg 2) (nil))))
