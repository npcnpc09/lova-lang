(def line-win [b l]
  (let a (nth b (nth l 0))
    (if (and (ne a 46) (and (eq a (nth b (nth l 1))) (eq a (nth b (nth l 2))))) a 0)))
(def winner-of [b ls]
  (if (nil? ls) 0 (let w (line-win b (head ls)) (if w w (winner-of b (tail ls))))))
(def lines-for [i]
  (cond (eq i 0) (list (list 0 1 2) (list 0 3 6) (list 0 4 8))
        (eq i 1) (list (list 0 1 2) (list 1 4 7))
        (eq i 2) (list (list 0 1 2) (list 2 5 8) (list 2 4 6))
        (eq i 3) (list (list 3 4 5) (list 0 3 6))
        (eq i 4) (list (list 3 4 5) (list 1 4 7) (list 0 4 8) (list 2 4 6))
        (eq i 5) (list (list 3 4 5) (list 2 5 8))
        (eq i 6) (list (list 6 7 8) (list 0 3 6) (list 2 4 6))
        (eq i 7) (list (list 6 7 8) (list 1 4 7))
        (list (list 6 7 8) (list 2 5 8))))
(def full [b] (not (contains b 46)))
(def other [p] (if (eq p 88) 79 88))
(def order [] (list 4 0 2 6 8 1 3 5 7))
(def set-at [xs i v]
  (if (eq i 0) (cons v (tail xs)) (cons (head xs) (set-at (tail xs) (sub i 1) v))))
(def nmax [b p alpha beta last]
  (if (winner-of b (lines-for last)) (neg 1)
    (if (full b) 0 (nloop b p 0 alpha beta (neg 2)))))
(def nloop [b p i alpha beta best]
  (if (ge i 9) best
    (let idx (nth order i)
      (if (ne (nth b idx) 46) (nloop b p (inc i) alpha beta best)
        (let v (neg (nmax (set-at b idx p) (other p) (neg beta) (neg alpha) idx))
          (let best2 (max best v)
            (let a2 (max alpha v)
              (if (ge a2 beta) best2 (nloop b p (inc i) a2 beta best2)))))))))
(def pick [b p i besti bestv]
  (if (ge i 9) besti
    (if (ne (nth b i) 46) (pick b p (inc i) besti bestv)
      (let v (neg (nmax (set-at b i p) (other p) (neg 2) (neg bestv) i))
        (if (gt v bestv) (pick b p (inc i) i v) (pick b p (inc i) besti bestv))))))
(let b (text-chars {board}) (pick b (head {side}) 0 0 (neg 2)))
