(def order9 [] (list 4 0 2 6 8 1 3 5 7))
(def all-cell-lines [] (list
  (list (list 0 1 2) (list 0 3 6) (list 0 4 8))
  (list (list 0 1 2) (list 1 4 7))
  (list (list 0 1 2) (list 2 5 8) (list 2 4 6))
  (list (list 3 4 5) (list 0 3 6))
  (list (list 3 4 5) (list 1 4 7) (list 0 4 8) (list 2 4 6))
  (list (list 3 4 5) (list 2 5 8))
  (list (list 6 7 8) (list 0 3 6) (list 2 4 6))
  (list (list 6 7 8) (list 1 4 7))
  (list (list 6 7 8) (list 2 5 8) (list 0 4 8))))
(def cell-lines [i] (nth all-cell-lines i))
(def line-win2 [b l v]
  (and (eq v (nth b (nth l 0))) (and (eq v (nth b (nth l 1))) (eq v (nth b (nth l 2))))))
(def win-at [b i]
  (let v (nth b i) (any (lambda l (line-win2 b l v)) (cell-lines i))))
(def other [p] (if (eq p 88) 79 88))
(def set-at [xs i v]
  (if (eq i 0) (cons v (tail xs)) (cons (head xs) (set-at (tail xs) (sub i 1) v))))
(def nmax [b p alpha beta li depth]
  (if (win-at b li) (neg 1)
    (if (ge depth 9) 0 (nloop b p order9 alpha beta (neg 1) depth))))
(def nloop [b p idxs alpha beta best depth]
  (if (nil? idxs) best
    (let i (head idxs)
      (if (ne (nth b i) 46) (nloop b p (tail idxs) alpha beta best depth)
        (let v (neg (nmax (set-at b i p) (other p) (neg beta) (neg alpha) i (inc depth)))
          (let best2 (max best v)
            (let a2 (max alpha v)
              (if (ge a2 beta) best2 (nloop b p (tail idxs) a2 beta best2 depth)))))))))
(def pick [b p i besti bestv depth]
  (if (ge i 9) besti
    (if (ne (nth b i) 46) (pick b p (inc i) besti bestv depth)
      (let v (neg (nmax (set-at b i p) (other p) (neg 1) 1 i (inc depth)))
        (if (gt v bestv) (pick b p (inc i) i v depth) (pick b p (inc i) besti bestv depth))))))
(let b (text-chars {board})
  (let depth (sub 9 (len (filter (lambda x (eq x 46)) b)))
    (pick b (head {side}) 0 0 (neg 2) depth)))
