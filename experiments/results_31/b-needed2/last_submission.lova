(def pows [] (list 1 4 16 64 256 1024 4096 16384 65536))
(def cell-lines-all [] (list
    (list (list 0 1 2) (list 0 3 6) (list 0 4 8))
    (list (list 0 1 2) (list 1 4 7))
    (list (list 0 1 2) (list 2 5 8) (list 2 4 6))
    (list (list 3 4 5) (list 0 3 6))
    (list (list 3 4 5) (list 1 4 7) (list 0 4 8) (list 2 4 6))
    (list (list 3 4 5) (list 2 5 8))
    (list (list 6 7 8) (list 0 3 6) (list 2 4 6))
    (list (list 6 7 8) (list 1 4 7))
    (list (list 6 7 8) (list 2 5 8) (list 0 4 8))))
(def order [] (list 4 0 2 6 8 1 3 5 7))
(def digit-at [b i] (mod (div b (nth pows i)) 4))
(def set-at [b i v] (merge b (mul (sub v (digit-at b i)) (nth pows i))))
(def cellcode [c] (if (eq c 88) 1 (if (eq c 79) 2 0)))
(def encode-i [xs i acc]
  (if (nil? xs) acc (encode-i (tail xs) (inc i) (merge acc (mul (cellcode (head xs)) (nth pows i))))))
(def encode [xs] (encode-i xs 0 0))
(def other [p] (sub 3 p))
(def line-eq [b l v]
  (and (eq v (digit-at b (nth l 0))) (and (eq v (digit-at b (nth l 1))) (eq v (digit-at b (nth l 2))))))
(def any-line-win [b ls v]
  (if (nil? ls) 0 (if (line-eq b (head ls) v) 1 (any-line-win b (tail ls) v))))
(def win-at [b i v] (any-line-win b (nth cell-lines-all i) v))
(def nmax [b p alpha beta li cnt]
  (if (win-at b li (other p)) (neg 1)
    (if (ge cnt 9) 0 (nloop b p 0 alpha beta (neg 2) cnt))))
(def nloop [b p k alpha beta best cnt]
  (if (ge k 9) best
    (let i (nth order k)
      (if (ne (digit-at b i) 0) (nloop b p (inc k) alpha beta best cnt)
        (let v (neg (nmax (set-at b i p) (other p) (neg beta) (neg alpha) i (inc cnt)))
          (let best2 (max best v)
            (let a2 (max alpha v)
              (if (ge a2 beta) best2 (nloop b p (inc k) a2 beta best2 cnt)))))))))
(def pick [b p k besti bestv alpha cnt]
  (if (ge k 9) besti
    (let i (nth order k)
      (if (ne (digit-at b i) 0) (pick b p (inc k) besti bestv alpha cnt)
        (let v (neg (nmax (set-at b i p) (other p) (neg 2) (neg alpha) i (inc cnt)))
          (if (or (gt v bestv) (and (eq v bestv) (lt i besti)))
            (pick b p (inc k) i v (max alpha v) cnt)
            (pick b p (inc k) besti bestv alpha cnt)))))))
(let chars (text-chars {board})
  (let b (encode chars)
    (let cnt (len (filter (lambda c (ne c 46)) chars))
      (let p (if (eq (head {side}) 88) 1 2)
        (pick b p 0 0 (neg 2) (neg 2) cnt)))))
