;;; fleet.lova  --  the health-check half of the fleet policy, standalone
;;;
;;; The defs below are `lib/fleet.lova`'s, verbatim: RemoteX's
;;; `healthCheck` parse (`stdout.split(/___(\w+)___/).filter(Boolean)`
;;; and the pairing loop after it), the four readers, the thresholds
;;; and the fleet report.  The tool-activation half is not here.
;;; `main` is added: a sweep in -- machines separated by a `---` line,
;;; each block's first line its name -- and one text out, a line a
;;; machine worst first, then a line of counts.

(def NA [] -1)                          ; a reading that was not there

;; --- the health parse -----------------------------------------------
;;
;; `stdout.split(/___(\w+)___/)`.  A word character is a letter, a digit
;; or an underscore; the engine is greedy and backtracks, so the name a
;; marker carries is the *longest* run of word characters with `___`
;; after it.  With `_` itself a word character that is not a detail:
;; `___cpu______mem___` is one marker named `cpu______mem`, not two.

(def word-char [c]
  (or (or (and (ge c 97) (le c 122)) (and (ge c 65) (le c 90)))
      (or (and (ge c 48) (le c 57)) (eq c 95))))

(def three-bars [s i]
  (and (le (merge i 3) (len s))
       (and (eq (nth s i) 95) (and (eq (nth s (merge i 1)) 95) (eq (nth s (merge i 2)) 95)))))

;; The end of the longest run of word characters from `i`.
(def word-run [s i]
  (get (iterate (rec at i)
                (lambda st (or (ge (get st at) (len s)) (not (word-char (nth s (get st at))))))
                (lambda st (put st at (inc (get st at)))))
       at))

;; Greedy with backtracking, for this one pattern: from the longest run
;; back toward the shortest, the first place with `___` after it wins.
;; A name must not be empty, so the walk stops one past the opening.
(def marker-end [s i]
  (let stop (word-run s (merge i 3))
    (get (iterate (rec at stop)
                  (lambda st (or (le (get st at) (merge i 3))
                                 (three-bars s (get st at))))
                  (lambda st (put st at (sub (get st at) 1))))
         at)))

(def marker-at [s i]
  (if (not (three-bars s i))
    (rec found 0 name "" after i)
    (let e (marker-end s i)
      (if (or (le e (merge i 3)) (not (three-bars s e)))
        (rec found 0 name "" after i)
        (rec found 1 name (text-slice s (merge i 3) e) after (merge e 3))))))

;; The next `___` at or after `i`, or the end of the text.  Jumping
;; there rather than walking took one machine's health from 17 800
;; steps to 11 100: a native search beats a loop written out.
(def next-bars [s i]
  (if (ge i (len s))
    (len s)
    (let hit (text-find (text-slice s i (len s)) "___")
      (if (lt hit 0) (len s) (merge i hit)))))

;; The pieces the split gives, with the empty ones dropped: text, name,
;; text, name, ... exactly as `.filter(Boolean)` leaves them.  The walk
;; finds the markers; the text after the last one is added afterwards,
;; because the walk stops at the end and has nowhere to put it.
(def sections [s]
  (let st (iterate (rec at (next-bars s 0) from 0 out (nil))
                   (lambda w (gt (get w at) (sub (len s) 1)))
                   (lambda w
                     (let m (marker-at s (get w at))
                       (if (get m found)
                         (let before (text-slice s (get w from) (get w at))
                           (put (put (put w out
                                          (append (append (get w out)
                                                          (if (nil? before) (nil)
                                                            (list before)))
                                                  (list (get m name))))
                                     at (get m after))
                                from (get m after)))
                         (put w at (next-bars s (inc (get w at))))))))
    (let tail (text-slice s (get st from) (len s))
      (append (get st out) (if (nil? tail) (nil) (list tail))))))

;; Pairs, the original's `for (i = 0; i < sections.length - 1; i += 2)`:
;; a name, then the text after it, trimmed.  An empty value shifts every
;; pair after it, and this reproduces that rather than fixing it.
(def fields [out]
  (let secs (append (sections out) (nil))
    (fold (lambda m (lambda i
            (if (lt (mul 2 i) (sub (len secs) 1))
              (map-put m (nth secs (mul 2 i)) (text-trim (nth secs (inc (mul 2 i)))))
              m)))
          (nil) (range 0 (inc (div (len secs) 2))))))

;; --- reading a number out of a reading ------------------------------
;;
;; Everything is integers: the readings arrive as text a shell printed,
;; and a threshold on tenths of a per cent is a threshold on an
;; integer.  The shell prints them in four shapes, so there are four
;; readers, and getting it wrong is quiet -- `12G/40G (31%)` has a
;; perfectly good number at the front that means nothing.

(def first-digit [s]
  (get (iterate (rec at 0)
                (lambda st (or (ge (get st at) (len s)) (digit (nth s (get st at)))))
                (lambda st (put st at (inc (get st at)))))
       at))

(def end-of-digits [s i]
  (get (iterate (rec at i)
                (lambda st (or (ge (get st at) (len s))
                               (not (digit (nth s (get st at))))))
                (lambda st (put st at (inc (get st at)))))
       at))

(def digits-from [s i]
  (get (iterate (rec at i n 0)
                (lambda st (or (ge (get st at) (len s)) (not (digit (nth s (get st at))))))
                (lambda st (put (put st n (merge (mul (get st n) 10)
                                                 (sub (nth s (get st at)) 48)))
                                at (inc (get st at)))))
       n))

(def first-number [s]
  (let i (first-digit s) (if (ge i (len s)) NA (digits-from s i))))

;; The first number in `s`, scaled by ten to the `places`: "12.3" at one
;; place is 123, "0.52" at two is 52, "31" at one is 310.  A missing
;; decimal digit is a zero and an extra one is dropped, which is what
;; reading to a fixed number of places means.
(def decimals [s places]
  (let i (first-digit s)
    (if (ge i (len s))
      NA
      (let whole (digits-from s i)
        (let j (end-of-digits s i)
          (let frac (if (and (lt j (len s)) (eq (nth s j) 46))
                      (text-slice s (inc j)
                                  (min (end-of-digits s (inc j)) (merge (inc j) places)))
                      "")
            (merge (mul whole (pow 10 places))
                   (mul (digits-from frac 0) (pow 10 (sub places (len frac)))))))))))

;; `12.3` -- what `top` gives, one place.
(def tenths [s] (decimals s 1))

;; `0.52 0.48 0.44` -- what `/proc/loadavg` gives, two places, and only
;; the first of the three is a threshold anybody sets.
(def hundredths [s] (decimals s 2))

;; `12G/40G (31%)` -- what `df -h` gives.  The number that matters is
;; the one against the `%`, not the one at the front: `12G` is how much
;; is used and means nothing without the size.
(def percent-tenths [s]
  (let m (text-find s "%")
    (if (lt m 0)
      NA
      (let from (get (iterate (rec at m)
                              (lambda st (or (le (get st at) 0)
                                             (let c (nth s (sub (get st at) 1))
                                               (not (or (digit c) (eq c 46))))))
                              (lambda st (put st at (sub (get st at) 1))))
                     at)
        (if (ge from m) NA (tenths (text-slice s from m)))))))

;; `3129/7823MB (40.0%)` -- what `free -m` gives.  The ratio of the two
;; integers rather than the percentage the string already carries.
;;
;; Rounded, not truncated: 3129/7823 is 39.997 per cent and the shell
;; prints `40.0`, so truncating would disagree with the number this
;; tool has always shown its operators.  Nothing is a float, so
;; nothing drifts; it is the last digit that is a choice.
(def ratio-tenths [s]
  (let bar (text-find s "/")
    (if (lt bar 0)
      NA
      (let used (first-number (text-slice s 0 bar))
        (let whole (first-number (text-slice s (inc bar) (len s)))
          (if (or (eq used NA) (or (eq whole NA) (le whole 0)))
            NA
            (div (merge (mul 2000 used) whole) (mul 2 whole))))))))

;; --- the judgement --------------------------------------------------
;;
;; Thresholds in tenths of a percent, in one place.  This is the part
;; RemoteX does not have: it returns the five strings and the model
;; decides, one server at a time.
;;
;;   0 ok      1 warn      2 alarm      3 nothing came back

(def CPU-WARN [] 850)
(def CPU-ALARM [] 950)
(def MEM-WARN [] 850)
(def MEM-ALARM [] 950)
(def DISK-WARN [] 800)
(def DISK-ALARM [] 900)
(def LOAD-WARN [] 800)                  ; load average 8, in hundredths
(def LOAD-ALARM [] 1600)                ; and 16

(def level-of [value warn alarm]
  (cond (eq value NA) 3
        (ge value alarm) 2
        (ge value warn) 1
        0))

(def verdict [out]
  (let f (fields out)
    (let cpu (tenths (map-get f "cpu" ""))
      (let mem (ratio-tenths (map-get f "mem" ""))
        (let disk (percent-tenths (map-get f "disk" ""))
          (let load (hundredths (map-get f "load" ""))
            (let levels (list (level-of cpu CPU-WARN CPU-ALARM)
                              (level-of mem MEM-WARN MEM-ALARM)
                              (level-of disk DISK-WARN DISK-ALARM)
                              (level-of load LOAD-WARN LOAD-ALARM))
              (rec cpu cpu mem mem disk disk load load
                   up (map-get f "uptime" "")
                   worst (fold (lambda a (lambda l (max a l))) 0 levels)
                   levels levels))))))))

;; --- the fleet ------------------------------------------------------
;;
;; A list of `(name output)` pairs in, one report out: the servers in
;; trouble first, and the counts, so two hundred machines are a line and
;; not two hundred blobs to read.

(def report-of [pair]
  (let v (verdict (head (tail pair)))
    (put v name (head pair))))

(def worse-first [a b]
  (if (ne (get a worst) (get b worst))
    (gt (get a worst) (get b worst))
    (text-lt (get a name) (get b name))))

(def fleet-report [pairs]
  (let rs (sort-by worse-first (map report-of pairs))
    (rec rows rs
         total (len rs)
         alarm (len (filter (lambda r (eq (get r worst) 2)) rs))
         warn (len (filter (lambda r (eq (get r worst) 1)) rs))
         quiet (len (filter (lambda r (eq (get r worst) 0)) rs))
         mute (len (filter (lambda r (eq (get r worst) 3)) rs)))))

;; --- the sweep ------------------------------------------------------
;;
;; One text holding a whole sweep: a line that is just `---` ends a
;; block, a block's first line is the machine's name, and the rest of
;; the block is what its health check printed.  A machine that never
;; answered has a name and nothing after it.

(def BAR [] "---")

;; The sweep's lines, cut into blocks at every `---` line.  A block is
;; a list of lines; the cut line belongs to neither side.
(def blocks-of [raw]
  (let st (fold (lambda w (lambda l
                  (if (eq (text-trim l) BAR)
                    (rec done (append (get w done) (list (get w cur))) cur (nil))
                    (put w cur (append (get w cur) (list l))))))
                (rec done (nil) cur (nil))
                (text-split raw "\n"))
    (append (get st done) (list (get st cur)))))

;; A block as the `(name output)` pair `fleet-report` wants.
(def pair-of [block]
  (if (nil? block)
    (list "" "")
    (list (text-trim (head block))
          (text-join (tail block) "\n"))))

;; A block with nothing in it at all is not a machine -- it is what two
;; `---` lines in a row leave behind, or the end of the file.
(def machines [raw]
  (map pair-of
       (filter (lambda b (not (nil? (text-trim (text-join b "\n")))))
               (blocks-of raw))))

;; --- saying it ------------------------------------------------------

(def row-line [r]
  (text-join (list (get r name) (int-text (get r worst))) " "))

(def counts-line [rep]
  (text-join (list (int-text (get rep total)) (int-text (get rep alarm))
                   (int-text (get rep warn)) (int-text (get rep quiet))
                   (int-text (get rep mute)))
             " "))

(def main [sweep]
  (let rep (fleet-report (machines sweep))
    (text-join (append (map row-line (get rep rows)) (list (counts-line rep)))
               "\n")))

(main {sweep})
