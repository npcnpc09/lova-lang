;;; fixed.lova  --  arithmetic for a language with no floating point
;;;
;;; `(use "fixed")`.  A length is in 1024ths, an angle in 256ths of a
;;; turn, and everything below is integers: a sine is a table lookup
;;; with three reflections, a square root is Newton's method, and a
;;; product of two fixed-point numbers is divided by ONE to bring it
;;; back.  It is what `lib/ray.lova` casts rays with and what
;;; `apps/cube.lova` turns a cube with; between them they are a
;;; demonstration that a language without floats can still do
;;; geometry, which was not obvious before either was written.
;;;
;;; The one rule to keep: after multiplying two fixed-point numbers,
;;; divide by ONE.  After dividing one by another, multiply by ONE
;;; first.  LOVA's integers are unbounded, so the intermediate never
;;; overflows and the order does not matter.

;; --- the unit and the circle ----------------------------------------
;;
;; ONE is 1.0.  A position is in 1024ths of a cell; an angle is in
;; 256ths of a turn, so 64 units is a right angle.  `sin-q` is the
;; first quarter of a sine, 1024 * sin(k * pi / 128), and the other
;; three quarters are the same numbers reflected.

(def ONE [] 1024)
(def TURN [] 256)

(def sin-q []
  (list 0 25 50 75 100 125 150 175 200 224 249 273 297
        321 345 369 392 415 438 460 483 505 526 548 569 590
        610 630 650 669 688 706 724 742 759 775 792 807 822
        837 851 865 878 891 903 915 926 936 946 955 964 972
        980 987 993 999 1004 1009 1013 1016 1019 1021 1023 1024 1024))

(def sin [ang]
  (let k (mod ang TURN)
    (cond (le k 64) (nth sin-q k)
          (le k 128) (nth sin-q (sub 128 k))
          (le k 192) (neg (nth sin-q (sub k 128)))
          (neg (nth sin-q (sub TURN k))))))

(def cos [ang] (sin (merge ang 64)))

;; The integer square root, by Newton from above -- x becomes the mean
;; of x and n/x, which halves the error while it is far and squares the
;; accuracy once it is near.  The first guess is n / ONE where that is
;; the larger, so a distance across a whole map settles in as few
;; rounds as the round edge of an orb.
(def isqrt [n]
  (if (lt n 4)
    (if (gt n 0) 1 0)
    (fold (lambda x (lambda i (div (merge x (div n x)) 2)))
          (max ONE (div n ONE))
          (range 0 12))))

(example (sin 0) 0)
(example (sin 64) 1024)
(example (sin 128) 0)
(example (sin 192) -1024)
(example (cos 0) 1024)


;; The angle a direction makes, in 256ths of a turn: 0 along +x, 64
;; along +y.  The first octant is found by bisection against the sine
;; table -- six halvings, the first of which is the whole octant, so
;; that a diagonal comes out as exactly 32 -- and the other seven are
;; reflections of it.  A resolution of one unit is 1.4 degrees, which
;; is what turning a character to face the way it walks needs.
(def octant [n d]
  (fold (lambda lo (lambda step
          (let mid (merge lo step)
            (if (ge (mul n (cos mid)) (mul d (sin mid))) mid lo))))
        0 (list 32 16 8 4 2 1)))

(def atan2 [y x]
  (if (and (eq x 0) (eq y 0))
    0
    (let ax (abs x)
      (let ay (abs y)
        (let a (if (le ay ax) (octant ay ax) (sub 64 (octant ax ay)))
          (cond (and (ge x 0) (ge y 0)) a
                (and (lt x 0) (ge y 0)) (sub 128 a)
                (and (lt x 0) (lt y 0)) (merge 128 a)
                (mod (sub 256 a) 256)))))))

(example (atan2 0 1024) 0)
(example (atan2 1024 0) 64)
(example (atan2 0 -1024) 128)
(example (atan2 -1024 0) 192)
(example (atan2 1024 1024) 32)
