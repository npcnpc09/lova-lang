;;; fixed.lova  --  arithmetic for a language with no floating point
;;;
;;; `(use "fixed")`.  A length is in 1024ths, an angle in 256ths of a
;;; turn, and everything below is integers: a sine is a table lookup
;;; with three reflections, a square root is Newton's method, and a
;;; product of two fixed-point numbers is divided by ONE to bring it
;;; back.  It is what `lib/ray.lova` casts rays with and what
;;; `apps/cube.lova` turns a cube with; between them they are a
;;; demonstration that a language without floats can still do
;;; geometry, which was not obvious before either was written.
;;;
;;; The one rule to keep: after multiplying two fixed-point numbers,
;;; divide by ONE.  After dividing one by another, multiply by ONE
;;; first.  LOVA's integers are unbounded, so the intermediate never
;;; overflows and the order does not matter.

;; --- the unit and the circle ----------------------------------------
;;
;; ONE is 1.0.  A position is in 1024ths of a cell; an angle is in
;; 256ths of a turn, so 64 units is a right angle.  `sin` is 1024 times
;; the sine: the first quarter is a table, 1024 * sin(k * pi / 128) for
;; k = 0..64, and the other three quarters are the same numbers
;; reflected.
;;
;; `sin`, `cos` and `isqrt` are operators since 6b (2026-10-31), with
;; `sin-fine`, `cos-fine` below and the prelude's `quot` and `nth`: the
;; fixed-point family, 0x58-0x5E.  They were defined here -- the table
;; a map built when the module was read, the reflections a `cond`, the
;; root twelve rounds of a `fold` -- and a sine cost thirty-odd steps, a
;; fine sine a hundred and twenty, a root sixty; the dearest tick of a
;; danmaku card that turns six rings of blades (东方天球谭, Yorihime's
;; Gion card) spent half its 181k steps in them, and is 89k with the
;; operators.  An operator is one step for its node.  The values are the definitions'
;; to the bit (`core/runtime.py`, `fixed_sin` and its neighbours, keeps
;; the table and says how each is read), and the examples below are the
;; ones the definitions had.
;;
;; `isqrt` is the integer square root by Newton from above -- x becomes
;; the mean of x and n/x, twelve times, from max(ONE, n / ONE), so a
;; distance across a whole map settles in as few rounds as the round
;; edge of an orb; nought below 1, one from 1 to 3.

(def ONE [] 1024)
(def TURN [] 256)

(example (sin 0) 0)
(example (sin 64) 1024)
(example (sin 128) 0)
(example (sin 192) -1024)
(example (cos 0) 1024)
(example (isqrt 1048576) 1024)
(example (isqrt 3) 1)
(example (isqrt -5) 0)


;; --- the fine circle: 4096ths of a turn -----------------------------
;;
;; A 256th of a turn is 1.4 degrees, which at twelve metres is 0.3 m: an
;; aim rebuilt from `atan2` missed a maiden who stood still by 0.12 m
;; (journal, 2026-09-27).  These are the same sine, read between its
;; table's entries -- a 4096th of a turn is 0.09 degrees -- and an
;; `atan2` bisected to the same grain.  The 256ths functions above are
;; unchanged; a program picks the grain it needs.  `sin-fine` and
;; `cos-fine` are operators (6b): the sine read on the line between the
;; table's entries, the step rounded toward zero.

(def TURN-FINE [] 4096)

(def octant-fine [n d]
  (fold (lambda lo (lambda step
          (let [mid (merge lo step)]
            (if (ge (mul n (cos-fine mid)) (mul d (sin-fine mid))) mid lo))))
        0 (list 512 256 128 64 32 16 8 4 2 1)))

(def atan2-fine [y x]
  (if (and (eq x 0) (eq y 0))
    0
    (let [ax (abs x)
          ay (abs y)
          a (if (le ay ax) (octant-fine ay ax) (sub 1024 (octant-fine ax ay)))]
      (cond (and (ge x 0) (ge y 0)) a
            (and (lt x 0) (ge y 0)) (sub 2048 a)
            (and (lt x 0) (lt y 0)) (merge 2048 a)
            (mod (sub 4096 a) 4096)))))

(example (sin-fine 0) 0)
(example (sin-fine 1024) 1024)
(example (sin-fine 2048) 0)
(example (cos-fine 0) 1024)
;; between the table's entries, the sine is read on the line between them
(example (sin-fine 8) 12)
(example (atan2-fine 1024 1024) 512)
(example (atan2-fine 0 -1024) 2048)
(example (atan2-fine -1024 0) 3072)
;; a direction twelve metres out is recovered to within a 4096th
(example (le (abs (sub (atan2-fine (sin-fine 700) (cos-fine 700)) 700)) 1) 1)


;; The angle a direction makes, in 256ths of a turn: 0 along +x, 64
;; along +y.  The first octant is found by bisection against the sine
;; table -- six halvings, the first of which is the whole octant, so
;; that a diagonal comes out as exactly 32 -- and the other seven are
;; reflections of it.  A resolution of one unit is 1.4 degrees, which
;; is what turning a character to face the way it walks needs.
(def octant [n d]
  (fold (lambda lo (lambda step
          (let mid (merge lo step)
            (if (ge (mul n (cos mid)) (mul d (sin mid))) mid lo))))
        0 (list 32 16 8 4 2 1)))

(def atan2 [y x]
  (if (and (eq x 0) (eq y 0))
    0
    (let ax (abs x)
      (let ay (abs y)
        (let a (if (le ay ax) (octant ay ax) (sub 64 (octant ax ay)))
          (cond (and (ge x 0) (ge y 0)) a
                (and (lt x 0) (ge y 0)) (sub 128 a)
                (and (lt x 0) (lt y 0)) (merge 128 a)
                (mod (sub 256 a) 256)))))))

(example (atan2 0 1024) 0)
(example (atan2 1024 0) 64)
(example (atan2 0 -1024) 128)
(example (atan2 -1024 0) 192)
(example (atan2 1024 1024) 32)
