;; The player's start, from the Player node of the same scene.
(def start [] (rec x 0 y 505 z 0))

;; A model by name, for the picture.
(def model-of [name]
  (cond
    (eq name "platform") platform
    (eq name "platform-medium") platform-medium
    (eq name "platform-grass-large-round") platform-grass-large-round
    (eq name "platform-falling") platform-falling
    (eq name "brick") brick
    (eq name "coin") coin
    (eq name "flag") flag
    (eq name "cloud") cloud
    (eq name "grass") grass
    (eq name "grass-small") grass-small
    (eq name "character") character
    platform))
