(def grass-trees-tall [] (mesh grass-trees-tall-vs grass-trees-tall-fs))

;; The catalogue, in the order the kit's Builder cycles through it:
;; a structure is its index here.  A model by index, and a price.
(def catalogue []
  (list
    (rec name "road-straight" price 25)
    (rec name "road-straight-lightposts" price 25)
    (rec name "road-corner" price 25)
    (rec name "road-split" price 25)
    (rec name "road-intersection" price 25)
    (rec name "pavement" price 10)
    (rec name "pavement-fountain" price 10)
    (rec name "building-small-a" price 50)
    (rec name "building-small-b" price 60)
    (rec name "building-small-c" price 70)
    (rec name "building-small-d" price 70)
    (rec name "building-garage" price 70)
    (rec name "grass" price 10)
    (rec name "grass-trees" price 25)
    (rec name "grass-trees-tall" price 25)))

(def model-of [index]
  (cond
    (eq index 0) road-straight
    (eq index 1) road-straight-lightposts
    (eq index 2) road-corner
    (eq index 3) road-split
    (eq index 4) road-intersection
    (eq index 5) pavement
    (eq index 6) pavement-fountain
    (eq index 7) building-small-a
    (eq index 8) building-small-b
    (eq index 9) building-small-c
    (eq index 10) building-small-d
    (eq index 11) building-garage
    (eq index 12) grass
    (eq index 13) grass-trees
    (eq index 14) grass-trees-tall
    road-straight))

