;; The Decoration node's clouds.  Each stands in the kit under a
;; full basis -- an arbitrary rotation with a non-uniform scale;
;; the picture draws a yaw and one scale, so each is the yaw its
;; x axis carries and the cube root of the basis's determinant,
;; which keeps the volume the kit gave it.
(def fps-clouds []
  (list
    (rec model "cloud" x  -9713 y   8702 z  21049 yaw   46 scale  4096)
    (rec model "cloud" x  26173 y   6505 z -12408 yaw  -48 scale  4096)
    (rec model "cloud" x   6565 y   6505 z -29343 yaw  -28 scale  4096)
    (rec model "cloud" x  -2820 y   2485 z  26008 yaw   32 scale  3072)
    (rec model "cloud" x  28173 y  12315 z  -5501 yaw  -52 scale  3072)
    (rec model "cloud" x -29299 y  16691 z  -5010 yaw  -47 scale  3072)
    (rec model "cloud" x -25743 y   9019 z -24839 yaw  -47 scale  3072)
    (rec model "cloud" x  14469 y  10357 z  17956 yaw -128 scale  2048)
    (rec model "cloud" x  -5233 y   2485 z -37520 yaw  -25 scale  2048)
    (rec model "cloud" x -30849 y   2485 z -14064 yaw   21 scale  2048)
    (rec model "cloud" x   -903 y  13342 z -30910 yaw  -46 scale  3072)))

;; Where the player stands, from the Player node of objects/player.tscn.
(def fps-player-start [] (rec x 0 y 512 z 0))

;; A model by name, for the picture.  `impact` is the one name
;; here the kit has no model for -- its burst is a 2D animated
;; sprite, sprites/burst_animation.tres -- and the cloud's cube
;; stands in for it, small and white, until there is better.
(def fps-model-of [name]
  (cond
    (eq name "platform") platform
    (eq name "platform-large-grass") platform-large-grass
    (eq name "wall-low") wall-low
    (eq name "wall-high") wall-high
    (eq name "cloud") cloud
    (eq name "grass") grass
    (eq name "grass-small") grass-small
    (eq name "enemy-flying") enemy-flying
    (eq name "blaster") blaster
    (eq name "blaster-repeater") blaster-repeater
    (eq name "impact") cloud
    platform))

;; The names the rules use: `level` and `model-of`, as the
;; platformer's assets spell them.
(def level [] fps-level)
(def model-of [name] (fps-model-of name))

;; The model a kind is drawn with.
(def fps-kind-model [k]
  (cond
    (eq k 1) "platform"
    (eq k 2) "wall-low"
    (eq k 3) "wall-high"
    (eq k 4) "platform-large-grass"
    "grass"))
